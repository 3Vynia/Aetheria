{
  "name": "aetheria",
  "private": true,
  "version": "1.0.0-beta.14",
  "description": "A fantasy idle RPG for the browser built with Vue 3 and PrimeVue.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-icons.mjs && vite build",
    "build:single": "node scripts/build-icons.mjs && vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/build-icons.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "i18n:progress": "node scripts/i18n-progress.mjs",
    "balance": "node scripts/balance-report.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1",
    "@primeuix/themes": "^3.0.1",
    "primeicons": "^8.0.2",
    "primevue": "^4.5.5",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/game-icons": "^1.2.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.13.0",
    "svgo": "^4.1.0",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
